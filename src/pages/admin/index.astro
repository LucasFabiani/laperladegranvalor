---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Administración | La Perla de Gran Valor</title>
  </head>

  <body>

    <header class="site-header">
      <div class="container header-inner">

        <a class="logo" href={import.meta.env.BASE_URL}>
          La Perla de Gran Valor
        </a>

        <nav class="nav">
          <a href={import.meta.env.BASE_URL}>
            Ver blog
          </a>
        </nav>

      </div>
    </header>


    <main class="container admin">

      <!-- LOGIN -->

      <section id="login-section">

        <h1>Administración</h1>

        <p>
          Ingresá para administrar los artículos.
        </p>

        <form id="login-form">

          <label>
            Contraseña

            <input
              type="password"
              id="login-password"
              required
            />
          </label>

          <button type="submit">
            Ingresar
          </button>

        </form>

        <p id="login-status"></p>

      </section>


      <!-- PANEL -->

      <section id="admin-section" hidden>

        <div class="admin-header">

          <div>
            <h1>Nuevo artículo</h1>

            <p>
              Publicá una nueva reflexión.
            </p>
          </div>

          <button id="logout">
            Cerrar sesión
          </button>

        </div>

        <div class="articles-header">
  <h2>Artículos</h2>

  <button
    type="button"
    id="new-post"
  >
    + Nuevo artículo
  </button>
</div>

<div id="articles-list">
  <p>Cargando artículos...</p>
</div>


        <form id="post-form">

          <label>
            Título

            <input
              type="text"
              id="title"
              required
            />
          </label>


          <label>
            Descripción

            <textarea
              id="description"
              rows="3"
              required
            ></textarea>
          </label>


          <label>
            Fecha

            <input
              type="date"
              id="date"
              required
            />
          </label>


          <label>
            Etiquetas

            <input
              type="text"
              id="tags"
              placeholder="Evangelio, Reflexión, Fe"
            />

            <small>
              Separalas con comas.
            </small>
          </label>


          <label>
            Contenido

            <textarea
              id="content"
              rows="18"
              required
              placeholder="# Título

Escribí aquí el artículo en Markdown..."
            ></textarea>
          </label>


          <button type="submit">
            Publicar artículo
          </button>

        </form>

        <p id="status"></p>

      </section>

    </main>


    <footer>
      <div class="container">
        © 2026 Lucas Fabiani. Todos los derechos reservados.
      </div>
    </footer>


    <script>

      const WORKER_URL =
        "https://blog-admin-api.laperladegranvalor.workers.dev";


      const loginSection =
        document.querySelector("#login-section");

      const adminSection =
        document.querySelector("#admin-section");

      const loginForm =
        document.querySelector("#login-form");

      const loginPassword =
        document.querySelector("#login-password");

      const loginStatus =
        document.querySelector("#login-status");

      const logoutButton =
        document.querySelector("#logout");

      const articlesList =
  document.querySelector("#articles-list");

const newPostButton =
  document.querySelector("#new-post");


      // =========================
      // MOSTRAR PANEL
      // =========================

      function showAdmin() {

        loginSection.hidden = true;
        adminSection.hidden = false;

        loadPosts();
      }


      // =========================
      // LOGIN
      // =========================

      loginForm?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const password =
            loginPassword.value;

          loginStatus.textContent =
            "Verificando...";

          try {

            const response =
              await fetch(
                `${WORKER_URL}/verify`,
                {
                  method: "POST",

                  headers: {
                    "Content-Type":
                      "application/json"
                  },

                  body: JSON.stringify({
                    password
                  })
                }
              );

            const result =
              await response.json();

            if (!response.ok) {

              loginStatus.textContent =
                "❌ Contraseña incorrecta.";

              return;
            }


            // Guardamos la contraseña solamente
            // durante esta sesión del navegador.

            sessionStorage.setItem(
              "admin_password",
              password
            );

            loginPassword.value = "";

            loginStatus.textContent = "";

            showAdmin();

          } catch (error) {

            console.error(error);

            loginStatus.textContent =
              "❌ No se pudo conectar con Cloudflare.";

          }

        }
      );


      // =========================
      // CERRAR SESIÓN
      // =========================

      logoutButton?.addEventListener(
        "click",
        () => {

          sessionStorage.removeItem(
            "admin_password"
          );

          adminSection.hidden = true;
          loginSection.hidden = false;

        }
      );


      // =========================
      // RECUPERAR SESIÓN
      // =========================

      if (
        sessionStorage.getItem(
          "admin_password"
        )
      ) {

        showAdmin();

      }


      // =========================
      // PUBLICAR
      // =========================

      const form =
        document.querySelector("#post-form");

      const status =
        document.querySelector("#status");


      form?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const button =
            form.querySelector("button");

          button.disabled = true;
          button.textContent =
            "Publicando...";

          status.textContent =
            "Publicando artículo...";


          const password =
            sessionStorage.getItem(
              "admin_password"
            );


          const title =
            document.querySelector(
              "#title"
            ).value;

          const description =
            document.querySelector(
              "#description"
            ).value;

          const date =
            document.querySelector(
              "#date"
            ).value;

          const tagsText =
            document.querySelector(
              "#tags"
            ).value;

          const content =
            document.querySelector(
              "#content"
            ).value;


          const tags =
            tagsText
              ? tagsText
                  .split(",")
                  .map(
                    (tag) => tag.trim()
                  )
                  .filter(Boolean)
              : [];


          try {

            const response =
              await fetch(
                `${WORKER_URL}/publish`,
                {
                  method: "POST",

                  headers: {
                    "Content-Type":
                      "application/json"
                  },

                  body: JSON.stringify({
                    password,
                    title,
                    description,
                    date,
                    tags,
                    content
                  })
                }
              );


            const result =
              await response.json();


            if (!response.ok) {

              status.textContent =
                "❌ " +
                (
                  result.error ||
                  "Error al publicar"
                );

              return;

            }


            status.textContent =
              "✅ Publicado correctamente.";

            form.reset();


          } catch (error) {

            console.error(error);

            status.textContent =
              "❌ No se pudo conectar con Cloudflare.";

          } finally {

            button.disabled = false;

            button.textContent =
              "Publicar artículo";

          }

        }
      );



async function loadPosts() {

  articlesList.innerHTML =
    "<p>Cargando artículos...</p>";

  const password =
    sessionStorage.getItem(
      "admin_password"
    );

  try {

    const response =
      await fetch(
        `${WORKER_URL}/posts`,
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            password
          })
        }
      );

    const result =
      await response.json();

    if (!response.ok) {

      articlesList.innerHTML =
        `<p>❌ ${result.error}</p>`;

      return;
    }

    const posts = result.posts;

    if (!posts.length) {

      articlesList.innerHTML =
        "<p>No hay artículos todavía.</p>";

      return;
    }

    articlesList.innerHTML = "";

    posts.forEach((post) => {

      const article =
        document.createElement("div");

      article.className =
        "admin-post";

      article.innerHTML = `
        <div>
          <strong>${post.slug}</strong>
        </div>

        <div class="admin-post-actions">

          <button
            type="button"
            disabled
          >
            Editar
          </button>

          <button
            type="button"
            disabled
          >
            Eliminar
          </button>

        </div>
      `;

      articlesList.appendChild(article);

    });

  } catch (error) {

    console.error(error);

    articlesList.innerHTML =
      "<p>❌ No se pudieron cargar los artículos.</p>";
  }
}

    </script>

  </body>
</html>