---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Administración | La Perla de Gran Valor</title>
  </head>

  <body>

    <header class="site-header">
      <div class="container header-inner">

        <a class="logo" href={import.meta.env.BASE_URL}>
          La Perla de Gran Valor
        </a>

        <nav class="nav">
          <a href={import.meta.env.BASE_URL}>Ver blog</a>
        </nav>

      </div>
    </header>


    <main class="container admin">

      <h1>Nuevo artículo</h1>

      <form id="post-form">
        <label>
  Contraseña

  <input
    type="password"
    id="password"
    required
  />
</label>

        <label>
          Título

          <input
            type="text"
            id="title"
            required
          />
        </label>


        <label>
          Descripción

          <textarea
            id="description"
            rows="3"
            required
          ></textarea>
        </label>


        <label>
          Fecha

          <input
            type="date"
            id="date"
            required
          />
        </label>


        <label>
          Etiquetas

          <input
            type="text"
            id="tags"
            placeholder="Evangelio, Reflexión, Fe"
          />

          <small>
            Separalas con comas.
          </small>
        </label>


        <label>
          Contenido

          <textarea
            id="content"
            rows="18"
            required
            placeholder="# Título

Escribí aquí el artículo en Markdown..."
          ></textarea>
        </label>


        <button type="submit">
          Publicar artículo
        </button>

      </form>

      <p id="status"></p>

    </main>
<script>
  const form = document.querySelector("#post-form");
  const status = document.querySelector("#status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const button = form.querySelector("button");

    if (button) {
      button.disabled = true;
      button.textContent = "Publicando...";
    }

    status.textContent = "Publicando artículo...";

    const password =
      document.querySelector("#password")?.value;

    const title =
      document.querySelector("#title")?.value;

    const description =
      document.querySelector("#description")?.value;

    const date =
      document.querySelector("#date")?.value;

    const tagsText =
      document.querySelector("#tags")?.value;

    const content =
      document.querySelector("#content")?.value;

    const tags = tagsText
      ? tagsText
          .split(",")
          .map((tag) => tag.trim())
          .filter(Boolean)
      : [];

    try {

      const response = await fetch(
        "https://blog-admin-api.laperladegranvalor.workers.dev/publish",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify({
            password,
            title,
            description,
            date,
            tags,
            content
          })
        }
      );

      const result = await response.json();

      if (!response.ok) {

        status.textContent =
          "❌ " +
          (result.error || "Error al publicar");

        return;
      }

      status.textContent =
        `✅ Publicado correctamente: ${result.file}`;

      form.reset();

    } catch (error) {

      console.error(error);

      status.textContent =
        "❌ No se pudo conectar con Cloudflare.";

    } finally {

      if (button) {
        button.disabled = false;
        button.textContent = "Publicar artículo";
      }

    }
  });
</script>

  </body>
</html>