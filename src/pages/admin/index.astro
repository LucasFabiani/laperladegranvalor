---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Administración | La Perla de Gran Valor</title>
  </head>

  <body>

    <header class="site-header">
      <div class="container header-inner">

        <a class="logo" href={import.meta.env.BASE_URL}>
          La Perla de Gran Valor
        </a>

        <nav class="nav">
          <a href={import.meta.env.BASE_URL}>
            Ver blog
          </a>
        </nav>

      </div>
    </header>


    <main class="container admin">

      <!-- LOGIN -->

      <section id="login-section">

        <h1>Administración</h1>

        <p>
          Ingresá para administrar los artículos.
        </p>

        <form id="login-form">

          <label>
            Contraseña

            <input
              type="password"
              id="login-password"
              required
            />
          </label>

          <button type="submit">
            Ingresar
          </button>

        </form>

        <p id="login-status"></p>

      </section>


      <!-- PANEL -->

      <section id="admin-section" hidden>

        <div class="admin-header">

          <div>
            <h1>Nuevo artículo</h1>

            <p>
              Publicá una nueva reflexión.
            </p>
          </div>

          <button id="logout">
            Cerrar sesión
          </button>

        </div>

        <div class="articles-header">
  <h2>Artículos</h2>

  <button
    type="button"
    id="new-post"
  >
    + Nuevo artículo
  </button>
</div>

<div id="articles-list">
  <p>Cargando artículos...</p>
</div>


        <form id="post-form">

          <label>
            Título

            <input
              type="text"
              id="title"
              required
            />
          </label>


          <label>
            Descripción

            <textarea
              id="description"
              rows="3"
              required
            ></textarea>
          </label>


          <label>
            Fecha

            <input
              type="date"
              id="date"
              required
            />
          </label>


          <label>
            Etiquetas

            <input
              type="text"
              id="tags"
              placeholder="Evangelio, Reflexión, Fe"
            />

            <small>
              Separalas con comas.
            </small>
          </label>


          <label>
            Contenido

            <textarea
              id="content"
              rows="18"
              required
              placeholder="# Título

Escribí aquí el artículo en Markdown..."
            ></textarea>
          </label>


          <button type="submit">
            Publicar artículo
          </button>

        </form>

        <p id="status"></p>

      </section>

    </main>


    <footer>
      <div class="container">
        © 2026 Lucas Fabiani. Todos los derechos reservados.
      </div>
    </footer>


    <script>

      const WORKER_URL =
        "https://blog-admin-api.laperladegranvalor.workers.dev";


      const loginSection =
        document.querySelector("#login-section");

      const adminSection =
        document.querySelector("#admin-section");

      const loginForm =
        document.querySelector("#login-form");

      const loginPassword =
        document.querySelector("#login-password");

      const loginStatus =
        document.querySelector("#login-status");

      const logoutButton =
        document.querySelector("#logout");

      const articlesList =
  document.querySelector("#articles-list");

const newPostButton =
  document.querySelector("#new-post");


      // =========================
      // MOSTRAR PANEL
      // =========================

      function showAdmin() {

        loginSection.hidden = true;
        adminSection.hidden = false;

        loadPosts();
      }


      // =========================
      // LOGIN
      // =========================

      loginForm?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const password =
            loginPassword.value;

          loginStatus.textContent =
            "Verificando...";

          try {

            const response =
              await fetch(
                `${WORKER_URL}/verify`,
                {
                  method: "POST",

                  headers: {
                    "Content-Type":
                      "application/json"
                  },

                  body: JSON.stringify({
                    password
                  })
                }
              );

            const result =
              await response.json();

            if (!response.ok) {

              loginStatus.textContent =
                "❌ Contraseña incorrecta.";

              return;
            }


            // Guardamos la contraseña solamente
            // durante esta sesión del navegador.

            sessionStorage.setItem(
              "admin_password",
              password
            );

            loginPassword.value = "";

            loginStatus.textContent = "";

            showAdmin();

          } catch (error) {

            console.error(error);

            loginStatus.textContent =
              "❌ No se pudo conectar con Cloudflare.";

          }

        }
      );


      // =========================
      // CERRAR SESIÓN
      // =========================

      logoutButton?.addEventListener(
        "click",
        () => {

          sessionStorage.removeItem(
            "admin_password"
          );

          adminSection.hidden = true;
          loginSection.hidden = false;

        }
      );


      // =========================
      // RECUPERAR SESIÓN
      // =========================

      if (
        sessionStorage.getItem(
          "admin_password"
        )
      ) {

        showAdmin();

      }


      // =========================
      // PUBLICAR
      // =========================

      const form =
        document.querySelector("#post-form");

      const status =
        document.querySelector("#status");


      form?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const button =
            form.querySelector("button");

          button.disabled = true;
          button.textContent =
            "Publicando...";

          status.textContent =
            "Publicando artículo...";


          const password =
            sessionStorage.getItem(
              "admin_password"
            );


          const title =
            document.querySelector(
              "#title"
            ).value;

          const description =
            document.querySelector(
              "#description"
            ).value;

          const date =
            document.querySelector(
              "#date"
            ).value;

          const tagsText =
            document.querySelector(
              "#tags"
            ).value;

          const content =
            document.querySelector(
              "#content"
            ).value;


          const tags =
            tagsText
              ? tagsText
                  .split(",")
                  .map(
                    (tag) => tag.trim()
                  )
                  .filter(Boolean)
              : [];


          try {

            const response =
              await fetch(
                `${WORKER_URL}/publish`,
                {
                  method: "POST",

                  headers: {
                    "Content-Type":
                      "application/json"
                  },

                  body: JSON.stringify({
                    password,
                    title,
                    description,
                    date,
                    tags,
                    content
                  })
                }
              );


            const result =
              await response.json();


            if (!response.ok) {

              status.textContent =
                "❌ " +
                (
                  result.error ||
                  "Error al publicar"
                );

              return;

            }


            status.textContent =
              "✅ Publicado correctamente.";

            form.reset();


          } catch (error) {

            console.error(error);

            status.textContent =
              "❌ No se pudo conectar con Cloudflare.";

          } finally {

            button.disabled = false;

            button.textContent =
              "Publicar artículo";

          }

        }
      );



async function loadPosts() {

  articlesList.innerHTML =
    "<p>Cargando artículos...</p>";

  const password =
    sessionStorage.getItem(
      "admin_password"
    );

  try {

    const response =
      await fetch(
        `${WORKER_URL}/posts`,
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            password
          })
        }
      );

    const result =
      await response.json();

    if (!response.ok) {

      articlesList.innerHTML =
        `<p>❌ ${result.error}</p>`;

      return;
    }

    const posts = result.posts;

    if (!posts.length) {

      articlesList.innerHTML =
        "<p>No hay artículos todavía.</p>";

      return;
    }

    articlesList.innerHTML = "";

    posts.forEach((post) => {

      const article =
        document.createElement("div");

      article.className =
        "admin-post";

      article.innerHTML = `
        <div>
          <strong>${post.slug}</strong>
        </div>

        <div class="admin-post-actions">

          <button
  type="button"
  class="edit-post"
  data-slug="${post.slug}"
>
  Editar
</button>

          <button
  type="button"
  class="delete-post"
  data-slug="${post.slug}"
  data-sha="${post.sha}"
>
  Eliminar
</button>

        </div>
      `;

      articlesList.appendChild(article);

    });

  } catch (error) {

    console.error(error);

    articlesList.innerHTML =
      "<p>❌ No se pudieron cargar los artículos.</p>";
  }
}

async function editPost(slug) {

  const password =
    sessionStorage.getItem(
      "admin_password"
    );

  status.textContent =
    "Cargando artículo...";

  try {

    const response =
      await fetch(
        `${WORKER_URL}/post`,
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            password,
            slug
          })
        }
      );

    const result =
      await response.json();

    if (!response.ok) {

      status.textContent =
        "❌ " +
        (result.error ||
          "No se pudo cargar");

      return;
    }

    const markdown =
      result.markdown;

    // Separar frontmatter y contenido
    const match =
      markdown.match(
        /^---\s*([\s\S]*?)\s*---\s*([\s\S]*)$/
      );

    if (!match) {

      status.textContent =
        "❌ El artículo no tiene un formato válido.";

      return;
    }

    const frontmatter =
      match[1];

    const content =
      match[2].trim();


    // Obtener datos del frontmatter
    const title =
      frontmatter.match(
        /^title:\s*["']?(.*?)["']?\s*$/m
      )?.[1] || "";

    const description =
      frontmatter.match(
        /^description:\s*["']?(.*?)["']?\s*$/m
      )?.[1] || "";

    const date =
      frontmatter.match(
        /^date:\s*(.*?)\s*$/m
      )?.[1] || "";

    const tags =
      [...frontmatter.matchAll(
        /^\s*-\s*["']?(.*?)["']?\s*$/gm
      )]
        .map(match => match[1])
        .join(", ");


    // Cargar en formulario
    document.querySelector("#title").value =
      title;

    document.querySelector("#description").value =
      description;

    document.querySelector("#date").value =
      date;

    document.querySelector("#tags").value =
      tags;

    document.querySelector("#content").value =
      content;


    // Guardar información para luego actualizar
    form.dataset.editingSlug =
      slug;

    form.dataset.editingSha =
      result.sha;


    status.textContent =
      `✏️ Editando: ${slug}`;

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });


  } catch (error) {

    console.error(error);

    status.textContent =
      "❌ No se pudo cargar el artículo.";
  }
}


async function deletePost(slug, sha) {

  const confirmed = confirm(
    `¿Seguro que querés eliminar "${slug}"?\n\n` +
    "Esta acción eliminará el archivo del repositorio."
  );

  if (!confirmed) return;


  const password =
    sessionStorage.getItem(
      "admin_password"
    );

  status.textContent =
    "Eliminando artículo...";


  try {

    const response =
      await fetch(
        `${WORKER_URL}/delete`,
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            password,
            slug,
            sha
          })
        }
      );


    const result =
      await response.json();


    if (!response.ok) {

      status.textContent =
        "❌ " +
        (
          result.error ||
          "No se pudo eliminar"
        );

      return;
    }


    status.textContent =
      "✅ Artículo eliminado correctamente.";


    // Si estábamos editando ese artículo,
    // limpiamos el formulario.

    if (
      form.dataset.editingSlug === slug
    ) {

      form.reset();

      delete form.dataset.editingSlug;
      delete form.dataset.editingSha;
    }


    // Actualizar la lista

    await loadPosts();


  } catch (error) {

    console.error(error);

    status.textContent =
      "❌ No se pudo conectar con Cloudflare.";
  }
}

articlesList?.addEventListener(
  "click",
  (event) => {

    const editButton =
      event.target.closest(
        ".edit-post"
      );

    if (editButton) {

      editPost(
        editButton.dataset.slug
      );

      return;
    }


    const deleteButton =
      event.target.closest(
        ".delete-post"
      );

    if (deleteButton) {

      deletePost(
        deleteButton.dataset.slug,
        deleteButton.dataset.sha
      );

    }

  }
);
    </script>

  </body>
</html>